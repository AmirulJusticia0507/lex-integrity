# Project Configuration
# Copy this file to .env and customize values

# Server Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here_change_this_in_production
CORS_ORIGIN=http://localhost:3001

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lex_integrity
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=redispass

# Local LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:14b
OLLAMA_TEMPERATURE=0.1

# RAG Pipeline Configuration
OLLAMA_AGENT_MODEL=lex-integrity-agent:latest
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE_MIN=30

# Hybrid Search (Vector + BM25) + RRF
RRF_K=60
HYBRID_ALPHA=0.5

# Cross-Encoder Reranker
RERANKER_ENABLED=false
RERANKER_URL=http://localhost:8001
RERANKER_MODEL=BAAI/bge-reranker-base

# HyDE Query Expansion
HYDE_ENABLED=false
HYDE_MODEL=lex-integrity-agent:latest

# Scraping Configuration
SCRAPER_TIMEOUT=30000
SCRAPER_MAX_RETRIES=3
SCRAPER_CONCURRENCY=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/server.log

# Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_MIMES=application/pdf

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Monitoring
METRICS_ENABLED=true
GRAFANA_DASHBOARD_URL=http://localhost:3002/d/lex-integrity