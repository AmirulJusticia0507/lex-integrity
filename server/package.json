{
  "name": "lex-integrity-api",
  "version": "1.0.0",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node src/scripts/seedData.js",
    "embeddings": "node src/scripts/generateEmbeddings.js",
    "evaluate": "node src/scripts/evaluateRAG.js",
    "evaluate:golden": "node src/scripts/evaluateRAG.js --dataset=src/scripts/golden_set.json",
    "test": "jest",

    "load:ma": "node src/scripts/loadMA.js",
    "load:mk": "node src/scripts/loadMK.js",
    "load:kemendagri": "node src/scripts/loadKemendagri.js",
    "load:all-new": "node src/scripts/loadMA.js && node src/scripts/loadMK.js && node src/scripts/loadKemendagri.js",

    "scrape:ma": "cd ../scripts/scraper && python jdih_ma_playwright.py --no-pdf --output-json ma_peraturan.json",
    "scrape:mk": "cd ../scripts/scraper && python jdih_mk_playwright.py --no-pdf --output-json mk_peraturan.json",
    "scrape:kemendagri": "cd ../scripts/scraper && python jdih_kemendagri_scraper.py --no-pdf --output-json kemendagri_peraturan.json",
    "scrape:national": "cd ../scripts/scraper && python jdih_national_api.py --instansi all --no-pdf",
    "scrape:national:ma": "cd ../scripts/scraper && python jdih_national_api.py --instansi ma --no-pdf --output-json ma_peraturan.json",
    "scrape:national:mk": "cd ../scripts/scraper && python jdih_national_api.py --instansi mk --no-pdf --output-json mk_peraturan.json",
    "scrape:national:kemendagri": "cd ../scripts/scraper && python jdih_national_api.py --instansi kemendagri --no-pdf --output-json kemendagri_peraturan.json",
    "scrape:all-new": "npm run scrape:ma && npm run scrape:mk && npm run scrape:kemendagri",
    "playwright:install": "python -m playwright install chromium"
  },
  "dependencies": {
    "axios": "^1.19.0",
    "bcryptjs": "^2.4.3",
    "bull": "^4.16.0",
    "cheerio": "^1.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.7.0",
    "helmet": "^7.0.0",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.0",
    "node-fetch": "^3.3.2",
    "ollama": "^0.6.3",
    "pg": "^8.23.0",
    "pg-hstore": "^2.3.4",
    "redis": "^4.6.0",
    "sequelize": "^6.37.8",
    "twilio": "^6.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "nodemon": "^3.0.1"
  },
  "author": "amirulputraj",
  "license": "MIT"
}
