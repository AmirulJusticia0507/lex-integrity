# Server Environment Configuration
# Copy this file to .env and customize values

# Server Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=your_jwt_secret_here_change_this_in_production
# Production: set ke URL frontend Vercel agar CORS lolos
CORS_ORIGIN=http://localhost:3001
# Contoh production: CORS_ORIGIN=https://lex-integrity.vercel.app

# Database Configuration (PostgreSQL)
# Lokal: pakai DB_HOST/DB_PORT/DB_NAME
# Railway/Production: cukup set DATABASE_URL (auto dari Railway Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/lex_integrity
DB_HOST=localhost
DB_PORT=5432
DB_NAME=lex_integrity
DB_USER=postgres
DB_PASSWORD=postgres

# Redis Configuration
# Lokal: redis://localhost:6379
# Railway: set REDIS_URL dari plugin Redis (redis://default:pass@host:port)
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=redispass

# Local LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:14b
OLLAMA_TEMPERATURE=0.1

# Scraping Configuration
SCRAPER_TIMEOUT=30000
SCRAPER_MAX_RETRIES=3
SCRAPER_CONCURRENCY=5

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
LOG_FILE=logs/server.log

# Upload Configuration
UPLOAD_MAX_SIZE=10485760
UPLOAD_ALLOWED_MIMES=application/pdf

# Cache Configuration
CACHE_TTL=3600
CACHE_MAX_SIZE=1000

# Monitoring
METRICS_ENABLED=true
GRAFANA_DASHBOARD_URL=http://localhost:3002/d/lex-integrity

# ═══════════════════════════════════════════════════════════════════
# WhatsApp (Twilio) Configuration
# Daftar di https://www.twilio.com/ untuk mendapatkan kredensial
# ═══════════════════════════════════════════════════════════════════
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890